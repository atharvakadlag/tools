#!/bin/bash
# Keeps a GitLab MR rebased on its target and its test-stage jobs running until unit tests finish.
set -u

usage() {
  cat <<EOF
Usage: mr-watch <mr-iid | mr-url> [-p group/project] [-i interval_seconds] [-j job_name]
  -p  project path (default: the-level-engineering/colossus; inferred from URL)
  -i  poll interval in seconds (default: 180)
  -j  job that decides success/failure (default: unit-tests)
Exit: 0 merged/closed or job passed + mergeable, 2 conflicts, 3 job failed
EOF
  exit 1
}

[ $# -lt 1 ] && usage
TARGET=$1; shift
PROJECT="the-level-engineering/colossus"
INTERVAL=180
JOB="unit-tests"
while getopts "p:i:j:h" opt; do
  case $opt in
    p) PROJECT=$OPTARG ;;
    i) INTERVAL=$OPTARG ;;
    j) JOB=$OPTARG ;;
    *) usage ;;
  esac
done

if [[ $TARGET =~ gitlab\.com/(.+)/-/merge_requests/([0-9]+) ]]; then
  PROJECT=${BASH_REMATCH[1]}
  MR=${BASH_REMATCH[2]}
elif [[ $TARGET =~ ^[0-9]+$ ]]; then
  MR=$TARGET
else
  usage
fi

P="projects/${PROJECT//\//%2F}"
LAST_REBASE=0

log() { echo "[$(date '+%H:%M:%S')] !$MR $*"; }
notify() { osascript -e "display notification \"$1\" with title \"mr-watch !$MR\"" 2>/dev/null; }

log "watching $PROJECT (job=$JOB, every ${INTERVAL}s)"

while true; do
  mr=$(glab api "$P/merge_requests/$MR?include_diverged_commits_count=true&include_rebase_in_progress=true" 2>/dev/null)
  if [ -z "$mr" ]; then log "API error, retrying"; sleep "$INTERVAL"; continue; fi

  read -r state dms conflicts diverged rebasing pipe pstatus <<<"$(echo "$mr" | python3 -c '
import sys,json;d=json.load(sys.stdin);hp=d.get("head_pipeline") or {}
print(d["state"],d["detailed_merge_status"],d["has_conflicts"],d.get("diverged_commits_count") or 0,d.get("rebase_in_progress"),hp.get("id","none"),hp.get("status","none"))' 2>/dev/null)"
  if [ -z "$state" ]; then log "bad API response, retrying"; sleep "$INTERVAL"; continue; fi
  log "state=$state merge_status=$dms diverged=$diverged pipeline=$pipe($pstatus)"

  if [ "$state" != "opened" ]; then log "DONE: MR is $state"; notify "MR is $state"; exit 0; fi
  if [ "$conflicts" = "True" ]; then log "STOP: conflicts, manual rebase needed"; notify "Conflicts - manual rebase needed"; exit 2; fi
  if [ "$rebasing" = "True" ]; then sleep 30; continue; fi

  if [ "$dms" = "need_rebase" ] || [ "$diverged" -gt 0 ]; then
    # Rebase can take a moment to clear diverged count; avoid firing repeatedly.
    if [ $(( $(date +%s) - LAST_REBASE )) -gt 120 ]; then
      log "behind target by $diverged commits -> rebasing"
      glab api -X PUT "$P/merge_requests/$MR/rebase" >/dev/null && LAST_REBASE=$(date +%s)
    fi
    sleep 60; continue
  fi

  if [ "$pipe" != "none" ]; then
    jobs=$(glab api "$P/pipelines/$pipe/jobs?per_page=100" 2>/dev/null)
    echo "$jobs" | python3 -c '
import sys,json
for j in json.load(sys.stdin):
    if j["stage"]=="test" and j["status"]=="manual": print(j["id"],j["name"])' | while read -r jid jname; do
      log "playing manual job $jname ($jid)"
      glab api -X POST "$P/jobs/$jid/play" >/dev/null
    done

    ut=$(echo "$jobs" | JOB="$JOB" python3 -c '
import os,sys,json
n=os.environ["JOB"]
print(next((j["status"]+" "+j["web_url"] for j in json.load(sys.stdin) if j["name"]==n),"absent -"))')
    log "$JOB: $ut"
    case "$ut" in
      failed*) log "STOP: $JOB failed"; notify "$JOB failed"; exit 3 ;;
      success*) [ "$dms" = "mergeable" ] && { log "DONE: $JOB passed, MR mergeable"; notify "$JOB passed - mergeable"; exit 0; } ;;
    esac
  fi

  sleep "$INTERVAL"
done
